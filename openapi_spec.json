{
  "openapi": "3.1.0",
  "info": {
    "title": "Genomic Allelic Association and Legacy Audit API",
    "description": "Local plaintext 2×2 allelic association statistics, plus legacy generic threshold-audit demonstrations. No homomorphic encryption, genotype-level GWAS QC, or clinical certification.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Repository maintainer",
      "url": "https://github.com/abusuraihsakhri/homomorphic-genomic-gwas-agent"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health and metadata",
        "responses": {
          "200": {
            "description": "Health JSON"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON process counters (not Prometheus exposition text)",
        "responses": {
          "200": {
            "description": "Runtime metrics JSON"
          }
        }
      }
    },
    "/api/gwas": {
      "post": {
        "summary": "Calculate plaintext 2×2 Pearson allelic chi-square and p-value",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "case_alt": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Non-negative plaintext allele count"
                  },
                  "case_ref": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Non-negative plaintext allele count"
                  },
                  "control_alt": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Non-negative plaintext allele count"
                  },
                  "control_ref": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Non-negative plaintext allele count"
                  }
                },
                "required": [
                  "case_alt",
                  "case_ref",
                  "control_alt",
                  "control_ref"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Execute legacy generic metric threshold checks (not a GWAS test)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number",
                    "default": 0
                  },
                  "status_descriptor": {
                    "type": "string",
                    "default": "NOMINAL"
                  },
                  "is_critical_flag": {
                    "type": "boolean",
                    "default": false
                  },
                  "attributes": {
                    "type": "object",
                    "default": {}
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return deterministic mock text; no LLM provider inference",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read in-memory HMAC audit metadata (requires configured bearer token)",
        "security": [
          {
            "AuditReadToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "In-memory audit entries and HMAC chain verification status"
          },
          "403": {
            "description": "Audit read token unset, invalid or missing"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AuditReadToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "AUDIT_READ_TOKEN environment variable, at least 24 characters. Endpoint rejects access when unset."
      }
    }
  }
}
